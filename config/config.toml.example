# apps/api 配置（两种构建形态共用，feature 门只决定装配哪些路由域）——
# 渠道/模型/密钥存 Postgres，本文件只放进程级参数。已 gitignore
# （config/config.toml），示例只放占位符。
listen = "0.0.0.0:3000"
log_level = "info"

# 调度健康参数（冷却阈值/时长）与转发重试预算已移到 PG `options` 表
# （`gateway.dispatch.*` / `gateway.retry.max_attempts` / `gateway.timeout.*`，
# 由 apps/api 装配侧读取）；单机配置文件不再覆盖它们，统一在管理台改。

# 计量定价。整段省略或 prices 为空 = 不计费（本地单机默认），转发不受影响。
# 填了价格就会挂上额度闸 QuotaGate；此时额度快照必须有对应 token 的余额，
# 否则请求恒 402。作为中转服务对外计费时才解开注释。
# [metering.prices."gpt-4o"]
# input = 2.5              # $/M 输入 tokens
# output = 10.0            # $/M 输出 tokens
# cache = 1.25             # $/M 缓存读 tokens
# group_multiplier = 1.0   # 分组倍率，默认 1.0

# 渠道配置。每个渠道定义一个上游供应商接入点。
# 整段省略 = 无渠道（空快照）。
[[channels]]
# 渠道名称（配置标识），作为 ChannelRecord.meta.key
name = "openai"
# 供应商协议族，默认 "openai"
provider_type = "openai"
# 上游服务基础地址
base_url = "https://api.example.com"
# API 密钥（本地明文）
api_key = "<UPSTREAM_API_KEY>"
# 对外提供的公开模型名列表
models = ["gpt-4o", "gpt-4"]
# 公开名 → 上游真实模型名的映射（可选，缺省时上游名 == 公开名）
# upstream_models = { "gpt-4" = "gpt-4o-2024-08-06" }
# 调度权重（默认 1）
weight = 1
# 调度优先级（默认 0）
priority = 0
# 最大并发数（默认 0 = 不限）
max_concurrency = 0

# 本地密钥配置。每个 key 用于鉴权。
# 整段省略 = 无本地 key（空快照）。
[[keys]]
# 明文 API 密钥（如 sk-local-xxx）
key = "sk-local-<RANDOM>"
# 密钥显示名称（可选）
name = "local-key-1"
# 密钥所属组，默认 "default"
group = "default"
# 允许的模型列表；空列表表示无限制
allowed_models = []

# 出口节点。url 支持 http(s):// socks5(h):// ss:// trojan:// vless:// vmess://；
# channel_keys 必须是上面某个 [[channels]].name。
# [[proxy_nodes]]
# url = "socks5://127.0.0.1:7890"
# channel_keys = ["openai"]
# priority = 10

# 支付渠道配置（apps/api 读取的 [payment] 段）。
# 整段省略 = 只用 manual 渠道（开单建 pending 单，admin 手工 settle 入账）。
# 父段预留：将来 stripe 挂 [payment.stripe]，与 epay 并列。
# [payment.epay]
# gateway_url = "https://pay.example.com"                  # 易支付根地址（跳转 {gateway_url}/mapi.php）
# pid = "10000"                                            # 商户 ID（易支付后台 pid）
# key = "<MERCHANT_KEY>"                                   # 商户密钥（MD5 签名用；禁提交真密钥）
# name = "充值"                                            # 商品名（支付页展示）
# notify_url = "https://your-host/api/topup/webhook/epay"  # 异步回调地址（本域 webhook 路径）
