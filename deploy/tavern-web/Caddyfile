# Ferrite 酒馆前端 caddy 配置。
# SPA 回落 + /tavern、/v1 反代到 api 容器（compose 服务名）。
# 注意：try_files 属 rewrite 类，默认先于 reverse_proxy 执行，会把 /tavern/*
# 也重写成 index.html。必须用 handle 互斥块把 API 路径排除在回落之外。
# 独立运行时需能解析主机名 api —— 请改 handle 块里的上游地址。
:8081 {
	root * /srv
	@api path /tavern/* /v1/*
	handle @api {
		reverse_proxy api:3000
	}
	# Dioxus live-reload WebSocket：必须 404，运行时据此判定无 dev server。
	# 若被 SPA 回落成 index.html(200)，app 会无限重连；Firefox/Zen 直接白屏。
	handle /_dioxus* {
		respond "no dev server" 404
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
